 import logging
+import re
 from typing import Optional
 
 from fastapi import Request, Response
@@ -54,6 +55,20 @@ from openg2p_registry_core.models import VcIssuanceStatusEnum
 _config = Settings.get_config()
 _logger = logging.getLogger(_config.logging_default_logger_name)
 
+# Claim code: XXXX-XXXX-XXXX over 32 symbols (no I/O/0/1), e.g. K7QM-2XPD-9TVR
+_CLAIM_CODE_TAIL = re.compile(r"[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$")
+
+
+def _claim_code(credential) -> Optional[str]:
+    """The claim code at the end of the VC `id` (id-field-prefix-uri + code) that Certify generates.
+
+    Certify stores every signed credential under this code; it is what the farmer types into
+    eSignet to download the credential into a wallet.
+    """
+    value = credential.get("id") if isinstance(credential, dict) else None
+    match = _CLAIM_CODE_TAIL.search(str(value or "").upper())
+    return match.group(0) if match else None
+
 # The permission an agent must hold. Agents are a distinct audience from staff:
 # a separate Keycloak realm and a separate portal, so holding staff permissions
 # grants nothing here.
@@ -542,9 +557,22 @@ class VcIssuanceController(BaseController):
                 status_code=502,
             )
 
+        claim_code = _claim_code(credential)
